---
layout: none
---

[
{% assign first_search_result = true %}
{% for page in site.pages %}
  {% assign path_parts = page.path | split: '/' %}
  {% if path_parts.size == 1 %}
    {% assign visibility_key = page.name | remove: ".md" %}
  {% else %}
    {% assign visibility_key = page.path | split: '/' | first %}
  {% endif %}
  {% assign visibility = site.section_visibility[visibility_key] | default: "listed" %}
  {% if visibility != "unlisted" %}
  {% unless first_search_result %},{% endunless %}
  {
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "content": {{ page.content | strip_html | strip_newlines | jsonify }}
  }
  {% assign first_search_result = false %}
  {% endif %}
{% endfor %}
]
